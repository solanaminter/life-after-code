# GCP runtime env vars (template — copy locally, never commit real values)
#
# How secrets flow in production:
#   - Cloud Build: values come from Secret Manager via --update-secrets in
#     cloudbuild.yaml (never stored in this repo).
#   - Manual deploy.sh: values are read from YOUR SHELL env, passed to
#     `gcloud run deploy`, and stored in GCP — nothing secret touches disk.
#
# For a demo-mode deploy the app needs NO secrets at all: MOCK_MODE=true makes
# the LLM/adapters/paypal/channel3 layers run on fixtures (see .env.example).

# "false" enables real LLM calls — requires LLM_API_KEY below.
MOCK_MODE=true

# LLM — any OpenAI-compatible provider (only needed when MOCK_MODE=false).
# Production: store in Secret Manager (name LLM_API_KEY), referenced by
# cloudbuild.yaml's --update-secrets. NEVER commit the value.
# LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# PayPal sandbox REST credentials (Phase 2 feature, unused by the hackathon
# demo path — leave unset unless wiring real PayPal in production).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=<redacted>

# Channel3 product-catalog API key (Phase 2 feature, unused by the demo path).
# CHANNEL3_API_KEY=<redacted>

# Cloud Run sets PORT itself (8080 default here). Do not set it manually.
# PORT=8080
